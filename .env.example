# Application Environment
FLASK_ENV=development
FLASK_APP=server.wsgi:app
PORT=5050
SECRET_KEY=dev-secret-key-change-in-production-fundi-connect-2026

# Database (PostgreSQL or SQLite for local dev)
DATABASE_URL=postgresql://fundi:fundipass@localhost:5435/fundi_connect
# Fallback local sqlite for tests/quick testing:
# DATABASE_URL=sqlite:///fundi_connect_dev.db

# JWT Authentication
JWT_SECRET_KEY=jwt-secret-key-change-in-production-fundi-2026
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://fundi-connect.vercel.app

# Platform Commission Settings (in basis points or percentage)
PLATFORM_COMMISSION_PERCENT=10.0

# Safaricom Daraja M-PESA API Credentials (Sandbox or Live)
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=your_consumer_key
DARAJA_CONSUMER_SECRET=your_consumer_secret
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
DARAJA_SHORTCODE=174379
DARAJA_CALLBACK_URL=https://fundi-api.onrender.com/api/v1/payments/daraja/callback
DARAJA_SIMULATION_MODE=true

# Demo-only escape hatch: permits DARAJA_SIMULATION_MODE under FLASK_ENV=production.
# Leave false on any instance that handles real customer money.
ALLOW_SIMULATED_PAYMENTS=false
